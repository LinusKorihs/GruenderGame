--- !u!114 &1667529468
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1437050874}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bc692c4a6c04307479335f7cce6722da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialoguePanel: {fileID: 6238006}
  dialogueText: {fileID: 6238005}
  preferSharedPrefabDialogPanel: 1
  dialogueLines:
  - "Well, look who made it back! The name\u2019s Pinch, I am the Shopkeeper \u2014
    yer one-stop shell for success!"
  - "See, once my wares are fully unpacked, ye\u2019ll be buyin\u2019 permanent upgrades
    right here. Better brawn for Kelp, and plenty o' perks to make those little Sluglings
    hit harder than an angry reef!"
  - "What\u2019s the catch? Cold, hard Cursed Doubloons, o' course! I don't run a
    charity here, kid!"
  - "How d\u2019ye get 'em? Simple: do well on yer Run! The deeper ye plunge and
    the more ruckus ye cause, the fatter yer pockets get"
  - "..Now don\u2019t go shovin\u2019 yer claws in me face just yet! Both the upgrades
    and the loot system are still Work in Progress!"
  - "A crab\u2019s gotta set up shop first, don\u2019t he? Hammerin' shelves, polishin'
    trinkets... it's honest sweat!"
  keyboardKey: 101
  controllerKey: 330
  interactSound:
    soundId: 
  elderKoiTalkSound:
    soundId: NPC.ElderKoi.Talk
  pinchTalkSound:
    soundId: NPC.Pinch.Talk
  playDialogueAnimation: 1
  playAnimationOnEachLine: 1
  restartAnimationOnEachLine: 1
  returnToIdleWhenDialogueEnds: 1
  elderKoiAnimator: {fileID: 0}
  pinchAnimator: {fileID: 0}
