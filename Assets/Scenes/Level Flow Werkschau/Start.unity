  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bc692c4a6c04307479335f7cce6722da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialoguePanel: {fileID: 6238006}
  dialogueText: {fileID: 6238005}
  preferSharedPrefabDialogPanel: 1
  dialogueLines:
  - I am the Elder Koi, the Lore Keeper and thy guide through this game.
  - To begin thy run, step into the marking at the center of the room.
  - Before thou venturest forth, choose how many Sluglings of each type shall follow
    thee.
  - 'A word of caution: the Support Sluglings art still a Work in Progress.'
  - Once thy army is chosen, thou shalt be cast into procedurally generated layers
    teeming with foes.
  - Command thy Sluglings to conquer these enemies, and seek the exit to the next
    layer.
  - "The spirits of this realm are still shaping the deep. If thou shouldst see the
    world stutter or fade at the seams\u2026 pay it no heed. Creation is an untamed
    tide."
  keyboardKey: 101
  controllerKey: 330
  playDialogueAnimation: 1
  playAnimationOnEachLine: 1
  restartAnimationOnEachLine: 1
  returnToIdleWhenDialogueEnds: 1
  elderKoiAnimator: {fileID: 0}
  pinchAnimator: {fileID: 0}
