  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialoguePanel: {fileID: 1851672594}
  dialogueText: {fileID: 1882458645}
  dialogueLines:
  - I am The Lore Keeper and Guide of this Game
  - To start a Run, step into the marking in the Center of the Room
  - You can choose how many Sluglings of each Type you want to bring on your andventure
  - (Support Slugling still WIP)
  - After choosing your Army, you will be transported to Procedually Generated Layers
    filled with enemies
  - Use the Sluglings to defeat these enemies and find the exit to the Next Layer.
  keyboardKey: 101
  controllerKey: 330
